---
import Base from './Base.astro';
import PostMeta from '../components/PostMeta.astro';
import RatingBadge from '../components/RatingBadge.astro';
import AuthorCard from '../components/AuthorCard.astro';
import CTABlock from '../components/CTABlock.astro';
import NetworkLinks from '../components/NetworkLinks.astro';
import { extractFAQSchema } from '../lib/faq-schema';

type Editorial = {
  kind: 'guide' | 'comparison' | 'research';
  takeaways: [string, string, string];
  stats?: { value: string; label: string; sourceName: string; sourceUrl: string; sourceDate: string }[];
  methodology?: string;
  verifiedAt?: string;
};

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  tags: string[];
  rating?: number;
  product?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  author: string;
  focusKeyword: string;
  seoTitle: string;
  rawContent?: string;
  networkLinks?: { title: string; url: string; site: 'ed' | 'fss' | 'calc' | 'help' | 'hype' }[];
  editorial?: Editorial;
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  description,
  date,
  updated,
  tags,
  rating,
  product,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  author,
  focusKeyword,
  seoTitle,
  rawContent,
  networkLinks,
  editorial,
  headings = [],
} = Astro.props;

const sections = editorial ? headings.filter((heading) => heading.depth === 2) : [];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const formattedUpdated = updated
  ? updated.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : null;

// --- Schema.org ---
const pageURL = Astro.url.href;
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
const sectionSlug = pathParts[0] ?? 'reviews';
const sectionLabels: Record<string, string> = {
  reviews: 'Reviews',
  compare: 'Comparisons',
  guides: "Buyer's Guides",
  gear: 'Tools & Gear',
};
const sectionLabel = sectionLabels[sectionSlug] ?? 'Articles';
const sectionURL = new URL(`/${sectionSlug}/`, Astro.site).href;

const authorSchema = {
  '@type': 'Person',
  '@id': 'https://www.wikidata.org/wiki/Q139572015',
  name: author,
  sameAs: [
    'https://www.wikidata.org/wiki/Q139572015',
    'https://github.com/mcpeezy',
    'https://www.linkedin.com/in/patrick-gibbs-839b7b237',
  ],
};

const publisher = {
  '@type': 'Organization',
  '@id': 'https://www.wikidata.org/wiki/Q139569923',
  name: 'Epiphany Dynamics',
  url: 'https://epiphanydynamics.ai',
  logo: { '@type': 'ImageObject', url: 'https://epiphanydynamics.ai/images/og-image.png' },
  sameAs: [
    'https://www.wikidata.org/wiki/Q139569923',
    'https://github.com/epiphany-dynamics',
    'https://www.linkedin.com/company/epiphanydynamics',
    'https://www.crunchbase.com/organization/epiphany-dynamics',
    'https://epiphanydynamics.ai',
    'https://fieldservicestack.com',
    'https://ai4bizcalculator.online',
    'https://epiphany.help',
    'https://hypebench.buzz',
  ],
};

const articleSchema = rating !== undefined
  ? {
      '@context': 'https://schema.org',
      '@type': 'Review',
      headline: title,
      description,
      author: authorSchema,
      publisher,
      datePublished: date.toISOString().split('T')[0],
      dateModified: (updated ?? date).toISOString().split('T')[0],
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
      itemReviewed: {
        '@type': sectionSlug === 'gear' ? 'Product' : 'SoftwareApplication',
        name: product,
      },
      reviewRating: { '@type': 'Rating', ratingValue: rating, bestRating: 10, worstRating: 0 },
      ...(image ? { image: new URL(image, Astro.site).href } : {}),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      author: authorSchema,
      publisher,
      datePublished: date.toISOString().split('T')[0],
      dateModified: (updated ?? date).toISOString().split('T')[0],
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageURL },
      ...(image ? { image: new URL(image, Astro.site).href } : {}),
    };

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fieldservicestack.com' },
    { '@type': 'ListItem', position: 2, name: sectionLabel, item: sectionURL },
    { '@type': 'ListItem', position: 3, name: title, item: pageURL },
  ],
};

const faqSchema = rawContent ? extractFAQSchema(rawContent) : null;
const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<Base title={seoTitle} description={description} ogImage={image} ogImageWidth={imageWidth} ogImageHeight={imageHeight} schema={schemas}>
  <article class="pt-10 pb-4 md:pt-16">
    <!-- Post Header -->
    <header class="post-header mx-auto mb-10 md:mb-14">
      <!-- Tags -->
      {tags.length > 0 && (
        <div class="rise rise-1 flex flex-wrap gap-2 mb-6">
          {tags.map((tag) => (
            <span class="tag-chip inline-block meta border border-border rounded-full px-3 py-1">
              {tag}
            </span>
          ))}
        </div>
      )}

      <h1 class="rise rise-2 post-title mb-5">{title}</h1>
      <p class="rise rise-3 post-dek mb-6">{description}</p>

      {product && (
        <p class="rise rise-3 text-muted text-lg mb-5 font-body">{product}</p>
      )}

      <div class="rise rise-3 flex flex-wrap items-center gap-x-5 gap-y-3">
        <PostMeta date={formattedDate} author={author} />

        {formattedUpdated && (
          <span class="meta">
            Updated {formattedUpdated}
          </span>
        )}
      </div>

      {rating !== undefined && (
        <div class="rise rise-4 mt-7">
          <RatingBadge rating={rating} />
        </div>
      )}

      {image && (
        <figure class="rise rise-4 mt-8">
          <button
            type="button"
            class="js-zoom group block w-full overflow-hidden rounded-xl border border-border"
            style="cursor: zoom-in;"
            data-zoom-src={image}
            aria-label="Enlarge image to read details"
          >
            <img
              src={image}
              alt={imageAlt || title}
              width={imageWidth}
              height={imageHeight}
              class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.02]"
              style="transition-timing-function: var(--ease-out-expo);"
              loading="eager"
            />
          </button>
        </figure>
      )}
    </header>

    {editorial && (
      <div class="editorial-intro mx-auto">
        <section class="editorial-panel" aria-labelledby="editorial-takeaways">
          <p class="editorial-eyebrow">The short version</p>
          <h2 id="editorial-takeaways" class="editorial-heading">Key takeaways</h2>
          <ol class="takeaway-grid">
            {editorial.takeaways.map((takeaway, index) => (
              <li class="takeaway-card"><span aria-hidden="true">0{index + 1}</span><p>{takeaway}</p></li>
            ))}
          </ol>
        </section>

        {sections.length > 0 && (
          <nav class="editorial-toc" aria-label="On this page">
            <h2 class="editorial-heading">On this page</h2>
            <ol>
              {sections.map((section) => (
                <li><a href={`#${section.slug}`}>{section.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        {editorial.stats && editorial.stats.length > 0 && (
          <section class="editorial-stats" aria-labelledby="editorial-data">
            <p class="editorial-eyebrow">Evidence at a glance</p>
            <h2 id="editorial-data" class="editorial-heading">Key figures</h2>
            <div class="stats-grid">
              {editorial.stats.map((stat) => (
                <div class="stat-card">
                  <p class="stat-value">{stat.value}</p>
                  <p class="stat-label">{stat.label}</p>
                  <p class="stat-source">Source: <a href={stat.sourceUrl}>{stat.sourceName}</a> · {stat.sourceDate}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    )}

    <!-- Article Body -->
    <div class:list={['prose article-prose mx-auto', { 'editorial-prose': editorial }]}>
      <slot />
    </div>

    {editorial?.methodology && (
      <section class="editorial-method mx-auto" aria-labelledby="editorial-method-title">
        <p class="editorial-eyebrow">How this article was prepared</p>
        <h2 id="editorial-method-title" class="editorial-heading">Sources and methodology</h2>
        <p>{editorial.methodology}</p>
        {editorial.verifiedAt && <p class="method-date">Sources checked {editorial.verifiedAt}</p>}
      </section>
    )}

    <!-- Author Card -->
    <footer class="max-w-[65ch] mx-auto mt-14 pt-10 border-t border-border">
      <AuthorCard author={author} />
    </footer>
  </article>

  <NetworkLinks links={networkLinks} />

  <!-- CTA Block -->
  <section class="mt-14">
    <CTABlock />
  </section>

  <!-- Image Lightbox: click any post image to read the fine print at full size -->
  <div id="image-lightbox" class="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged image" aria-hidden="true">
    <button id="lightbox-close" class="lightbox__close" type="button" aria-label="Close image">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <img id="lightbox-img" class="lightbox__img" src="" alt="" />
    <span class="lightbox__hint">Click anywhere or press Esc to close</span>
  </div>
</Base>

<style>
  .post-header, .editorial-intro { max-width: 72rem; }
  .post-header h1 { max-width: 25ch; }
  .post-dek { max-width: 75ch; color: var(--color-cream-dim); font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.55; }
  .editorial-intro { display: grid; gap: 1.25rem; align-items: start; margin-bottom: 2.75rem; }
  .editorial-method { max-width: 75ch; }
  .editorial-panel, .editorial-toc, .editorial-stats, .editorial-method {
    border: 1px solid var(--color-border-strong);
    border-radius: 1rem;
    background: var(--color-surface);
    padding: clamp(1.25rem, 4vw, 2rem);
    margin-bottom: 1.25rem;
  }
  .editorial-panel, .editorial-toc { margin-bottom: 0; }
  .editorial-eyebrow {
    color: var(--color-accent);
    font: 600 .7rem var(--font-mono);
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: .6rem;
  }
  .editorial-heading { font-size: clamp(1.35rem, 3vw, 1.8rem); margin-bottom: 1.25rem; }
  .takeaway-grid, .stats-grid { display: grid; gap: .8rem; }
  .takeaway-grid { list-style: none; padding: 0; }
  .takeaway-card { display: flex; gap: 1rem; min-width: 0; padding: .8rem 0; border-top: 1px solid var(--color-border); }
  .takeaway-card span { flex: none; color: var(--color-accent); font: 600 .75rem var(--font-mono); padding-top: .25rem; }
  .takeaway-card p { line-height: 1.55; }
  .stat-card { min-width: 0; border: 1px solid var(--color-border); border-radius: .7rem; background: var(--color-raised); padding: 1rem; }
  .editorial-toc ol { display: grid; gap: .7rem; padding-left: 1.2rem; }
  .editorial-toc li::marker { color: var(--color-accent); }
  .editorial-toc a { color: var(--color-cream); text-decoration: underline; text-decoration-color: var(--color-border-strong); text-underline-offset: .2em; }
  .editorial-toc a:hover, .editorial-toc a:focus-visible, .stat-source a:hover, .stat-source a:focus-visible { color: var(--color-accent); }
  .stat-value { color: var(--color-accent); font: 700 clamp(1.8rem, 4vw, 2.5rem) var(--font-heading); overflow-wrap: anywhere; }
  .stat-label { margin: .2rem 0 .9rem; font-weight: 600; }
  .stat-source, .method-date { color: var(--color-muted); font-size: .75rem; line-height: 1.6; }
  .stat-source a { color: var(--color-cream); text-decoration: underline; overflow-wrap: anywhere; }
  .editorial-method p:not(.editorial-eyebrow) { line-height: 1.7; }
  .editorial-method .method-date { margin-top: .8rem; }
  :global(.editorial-prose h2) { scroll-margin-top: 2rem; }
  :global(.editorial-prose blockquote) { background: var(--color-accent-dim); border-left: 3px solid var(--color-accent); border-radius: 0 .65rem .65rem 0; padding: 1.1rem 1.35rem; font-style: normal; }
  :global(.editorial-prose blockquote p:last-child) { margin-bottom: 0; }
  :global(.editorial-prose table) { white-space: normal; }
  :global(.editorial-prose th), :global(.editorial-prose td) { min-width: 9rem; vertical-align: top; }
  :global(.editorial-prose li) { padding-left: .2rem; }
  @media (min-width: 900px) {
    .editorial-intro:has(.editorial-toc) { grid-template-columns: minmax(0, 2.4fr) minmax(14rem, 1fr); }
    .editorial-toc { position: sticky; top: 5rem; }
    .editorial-stats { grid-column: 1 / -1; }
  }
  @media (min-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .post-title {
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    line-height: 1.08;
  }

  .tag-chip {
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart);
  }
  .tag-chip:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    /* tinted toward the site's --color-dark (#050505), not flat black */
    background: rgba(5, 5, 5, 0.94);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    cursor: zoom-out;
    transition: opacity 0.28s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.28s;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .lightbox__img {
    max-width: 95vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    transform: scale(0.96);
    transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lightbox.is-open .lightbox__img {
    transform: scale(1);
  }
  .lightbox__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(240, 239, 235, 0.22);
    background: rgba(10, 10, 10, 0.6);
    color: #f0efeb;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .lightbox__close:hover {
    border-color: rgba(240, 239, 235, 0.55);
    background: rgba(10, 10, 10, 0.92);
  }
  .lightbox__hint {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: rgba(240, 239, 235, 0.55);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox__img {
      transition: none;
    }
  }
</style>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    if (!lightbox || !lightboxImg) return;

    let lastFocused = null;

    function open(src, alt) {
      lightboxImg.setAttribute('src', src);
      lightboxImg.setAttribute('alt', alt || '');
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      lastFocused = document.activeElement;
    }

    function close() {
      if (!lightbox.classList.contains('is-open')) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      window.setTimeout(() => {
        if (!lightbox.classList.contains('is-open')) lightboxImg.setAttribute('src', '');
      }, 350);
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
    }

    // (Re)bind triggers on every init — the post images are page-specific.
    document.querySelectorAll('.js-zoom').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const src = trigger.getAttribute('data-zoom-src');
        const innerImg = trigger.querySelector('img');
        if (src) open(src, innerImg ? innerImg.getAttribute('alt') : '');
      });
    });

    // Bind the overlay/global handlers only once.
    if (!lightbox.dataset.bound) {
      lightbox.dataset.bound = 'true';
      lightbox.addEventListener('click', close); // click anywhere (backdrop, image, X) closes
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') close();
      });
    }
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
